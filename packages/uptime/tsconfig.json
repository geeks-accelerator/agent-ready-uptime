{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Temporal"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true,
    // The checks package from its source in this workspace (the build reads its dist: tsconfig.build.json).
    "paths": { "agent-ready-checks/*": ["../checks/src/*.ts"] }
  },
  "include": ["src", "test"]
}
