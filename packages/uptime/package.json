{
  "name": "agent-ready-uptime",
  "version": "0.1.0",
  "description": "Agent-ready uptime monitoring, open source: uptime, TLS and domain expiry, sitemaps, llms.txt, AI crawler access and MCP tool changes, with alerts to Discord or Slack and a status page.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "agent-ready-uptime": "dist/bin.js"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "monitor.config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/bin.js schema > monitor.config.schema.json",
    "test": "vitest run"
  },
  "dependencies": {
    "agent-ready-checks": "0.1.0",
    "zod": "^4.6.7"
  },
  "keywords": ["uptime-monitor", "uptime-monitoring", "website-monitoring", "status-page", "self-hosted", "mcp", "model-context-protocol", "llms-txt", "ai-agents", "agent-readiness", "ai-crawlers", "robots-txt", "discord", "slack", "railway"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geeks-accelerator/agent-ready-uptime.git",
    "directory": "packages/uptime"
  }
}
